{
  "name": "playwright-extension-cli",
  "version": "0.0.1",
  "description": "Drive your browser from the command line through the Playwright Chrome Extension",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pwcli": "./dist/cli.js",
    "playwright-extension-cli": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "playwright",
    "chrome-extension",
    "cli",
    "browser-automation",
    "cdp",
    "mcp"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node scripts/args-test.mjs && node scripts/relay-test.mjs",
    "test:manual": "npm run build && node scripts/manual-path-test.mjs",
    "test:cli": "npm run build && node scripts/cli-test.mjs",
    "test:chrome": "scripts/setup-test-chrome.sh",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "1.64.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
