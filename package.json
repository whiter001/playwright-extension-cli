{
  "name": "playwright-mcp-cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI that bridges an MCP client to the Playwright Chrome Extension (protocol v2)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pwcli": "./dist/cli.js",
    "playwright-mcp-cli": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "npm run build && node scripts/args-test.mjs && node scripts/relay-test.mjs",
    "test:manual": "npm run build && node scripts/manual-path-test.mjs",
    "test:cli": "npm run build && node scripts/cli-test.mjs",
    "test:chrome": "scripts/setup-test-chrome.sh",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "1.64.0-alpha-1790635538000",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
